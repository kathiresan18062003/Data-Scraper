{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build && node clean.js",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{frontend/**,node_modules/**,tests/**,data/**,output/**,scratch/**,tools/**,*.md,*.bat}",
      "maxDuration": 60
    },
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{frontend/**,node_modules/**,tests/**,data/**,output/**,scratch/**,tools/**,*.md,*.bat}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
