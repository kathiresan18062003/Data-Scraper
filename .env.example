# ========================================================
# Product Data Scraper Dashboard - Environment Variables
# ========================================================

# Google Gemini API Key (Required for AI product attribute extraction)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database URL
# Local SQLite default:
DATABASE_URL=sqlite:///./data/scraper.db
# For production PostgreSQL (e.g. Supabase, Neon, Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Storage Directories (Automatically falls back to /tmp on serverless environments)
DATA_DIR=./data
OUTPUT_DIR=./output

# Scraper Performance & Thresholds
REQUEST_TIMEOUT=20
DOMAIN_DELAY=1.5
VALID_SCORE=35

# CORS Allowed Origins (Comma-separated)
# Automatically allows https://*.vercel.app in production
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://data-scraper-kathiresan-m1.vercel.app
